# dependências
node_modules/
extension/node_modules/
training/.venv/

# Python
__pycache__/
*.py[cod]

# dados de treino — são amostras suas (geometria da sua mão) e do dataset
# externo. Ficam de fora por padrão: veja o README antes de decidir publicar.
training/data/*.csv
training/data/*.json
training/data/external/
# exceção: o gesto sintético de referência do teste de paridade não é dado de
# ninguém, e sem ele o `npm test` falha em quem clonar o repositório
!training/data/parity_fixture.json

# arquivos grandes baixados/gerados (ver README para reobtê-los)
extension/lib/mediapipe/
# a pasta models/ precisa existir num clone limpo, senão o download falha
!extension/lib/models/.gitkeep
extension/lib/models/hand_landmarker.task
extension/lib/models/face_landmarker.task
extension/lib/models/letter_classifier.json
extension/lib/models/movement_classifier.json
